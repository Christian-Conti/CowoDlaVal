{% extends "base.html" %}
{% load i18n %}
{% block title %}{% translate "Bookings" %} - Cowo d'la val{% endblock %}
{% block content %}
<section class="page-section shell">
    <div class="heading-row">
        <div>
            <p class="eyebrow">COWO D'LA VAL</p>
            <h1>{% translate "Bookings" %}</h1>
        </div>
        <a class="button" href="{% url 'home' %}#booking">{% translate "New booking" %}</a>
    </div>
    <div class="table-card">
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>{% translate "Booking code" %}</th>
                        <th>{% translate "Desk" %}</th>
                        {% if user.is_staff %}<th>{% translate "User" %}</th>{% endif %}
                        <th>{% translate "Date" %}</th>
                        <th>{% translate "Status" %}</th>
                        <th>{% translate "Price" %}</th>
                        <th>{% translate "Payment method" %}</th>
                        <th>{% translate "Payment status" %}</th>
                        <th>{% translate "Action" %}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for booking in bookings %}
                        <tr>
                            <td data-label="{% translate 'Booking code' %}"><strong>{{ booking.booking_code }}</strong></td>
                            <td data-label="{% translate 'Desk' %}">{{ booking.space }}</td>
                            {% if user.is_staff %}<td data-label="{% translate 'User' %}">{{ booking.user.username }}</td>{% endif %}
                            <td data-label="{% translate 'Date' %}">{{ booking.date|date:"SHORT_DATE_FORMAT" }}</td>
                            <td data-label="{% translate 'Status' %}"><span class="status {{ booking.status }}">{{ booking.get_status_display }}</span></td>
                            <td data-label="{% translate 'Price' %}">€{{ booking.amount }}</td>
                            <td data-label="{% translate 'Payment method' %}">{{ booking.get_payment_method_display }}</td>
                            <td data-label="{% translate 'Payment status' %}"><span class="status {{ booking.payment_status }}">{{ booking.get_payment_status_display }}</span></td>
                            <td data-label="{% translate 'Action' %}">
                                <div class="table-actions">
                                    <a class="button secondary compact" href="{% url 'booking_detail' booking.id %}">{% translate "Manage" %}</a>
                                {% if booking.can_user_cancel %}
                                    <form method="post" action="{% url 'booking_cancel' booking.id %}">
                                        {% csrf_token %}
                                        <button class="danger-button" type="submit">{% translate "Cancel" %}</button>
                                    </form>
                                {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% empty %}
                        <tr><td class="mobile-table-empty" colspan="{% if user.is_staff %}10{% else %}9{% endif %}">{% translate "No bookings yet." %}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</section>
{% endblock %}
