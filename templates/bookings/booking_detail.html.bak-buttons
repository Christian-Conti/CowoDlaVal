{% extends "base.html" %}
{% load i18n %}
{% block title %}{{ booking.booking_code }} - Cowo d'la val{% endblock %}
{% block content %}
<section class="page-section shell narrow-shell">
    <div class="heading-row">
        <div>
            <p class="eyebrow">{% translate "Booking" %}</p>
            <h1 class="detail-title">{{ booking.booking_code }}</h1>
        </div>
        <a class="button secondary" href="{% url 'booking_list' %}">{% translate "All bookings" %}</a>
    </div>
    <section class="detail-card">
        <dl class="booking-facts">
            <div><dt>{% translate "Desk" %}</dt><dd>{{ booking.space }}</dd></div>
            <div><dt>{% translate "Date" %}</dt><dd>{{ booking.date|date:"SHORT_DATE_FORMAT" }}</dd></div>
            <div><dt>{% translate "Access hours" %}</dt><dd>{{ booking.space.opening_time|time:"H:i" }}–{{ booking.space.closing_time|time:"H:i" }}</dd></div>
            <div><dt>{% translate "Booking status" %}</dt><dd><span class="status {{ booking.status }}">{{ booking.get_status_display }}</span></dd></div>
            <div><dt>{% translate "Rate" %}</dt><dd>{{ booking.get_tariff_category_display }}</dd></div>
            <div><dt>{% translate "Price" %}</dt><dd>€{{ booking.amount }} {{ booking.currency }}</dd></div>
            <div><dt>{% translate "Payment method" %}</dt><dd>{{ booking.get_payment_method_display }}</dd></div>
            <div><dt>{% translate "Payment status" %}</dt><dd><span class="status {{ booking.payment_status }}">{{ booking.get_payment_status_display }}</span></dd></div>
            {% if booking.payment_reference %}<div><dt>{% translate "Payment reference" %}</dt><dd>{{ booking.payment_reference }}</dd></div>{% endif %}
            {% if booking.notes %}<div><dt>{% translate "Notes" %}</dt><dd>{{ booking.notes }}</dd></div>{% endif %}
        </dl>

        {% if booking.payment_due %}
            <p class="payment-due">{% translate "Payment is due on site." %}</p>
        {% elif not booking.payment_method and booking.status == "confirmed" %}
            <p><a class="button" href="{% url 'booking_payment' booking.id %}">{% translate "Choose payment" %}</a></p>
        {% endif %}

        <div class="detail-actions">
            {% if booking.can_user_modify %}
                <a class="button secondary" href="{% url 'booking_modify' booking.id %}">{% translate "Modify booking" %}</a>
            {% endif %}
            {% if booking.can_user_cancel %}
                <form method="post" action="{% url 'booking_cancel' booking.id %}">
                    {% csrf_token %}
                    <button class="danger-button" type="submit">{% translate "Cancel booking" %}</button>
                </form>
            {% endif %}
        </div>

        {% if booking.can_user_cancel %}
            <p class="policy-notice">{% translate "Only bookings with payment in person can be cancelled autonomously. For cancellations less than 12 hours before the booking, a 50% expense reimbursement is requested." %}</p>
        {% elif booking.payment_method != "onsite" %}
            <p class="policy-notice">{% translate "Online-paid bookings cannot be cancelled or modified automatically. Contact the coworking staff if you need a change or refund." %}</p>
        {% endif %}
    </section>
</section>
{% endblock %}
