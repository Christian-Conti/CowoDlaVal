#, python-format
msgid "Cowo d'la val booking %(code)s"
msgstr "Réservation Cowo d'la val %(code)s"

msgid "Desk"
msgstr "Poste"

msgid "Date"
msgstr "Date"

msgid "Rate"
msgstr "Tarif"

msgid "Requests or notes"
msgstr "Demandes ou notes"

msgid "For example: extra monitor, projector, wood stove assistance..."
msgstr ""
"Par exemple : écran supplémentaire, vidéoprojecteur, aide avec le poêle à "
"bois..."

msgid "You cannot book a past date."
msgstr "Vous ne pouvez pas réserver une date passée."

msgid "Payment method"
msgstr "Mode de paiement"

msgid "View bookings and payment status by date."
msgstr "Afficher les réservations et leur statut de paiement par date."

msgid "Show YYYY-MM-DD and exit."
msgstr "Afficher AAAA-MM-JJ et quitter."

msgid "Show today and exit."
msgstr "Afficher aujourd'hui et quitter."

msgid "First date in a non-interactive range."
msgstr "Première date d'une plage non interactive."

msgid "Last date in a non-interactive range."
msgstr "Dernière date d'une plage non interactive."

msgid "--from-date and --to-date must be used together."
msgstr "--from-date et --to-date doivent être utilisés ensemble."

msgid "--to-date cannot be earlier than --from-date."
msgstr "--to-date ne peut pas précéder --from-date."

msgid "[p]revious [n]ext [j]ump [r]ange [q]uit: "
msgstr "[p] précédent [n] suivant [j] choisir une date [r] plage [q] quitter : "

msgid "Date (YYYY-MM-DD): "
msgstr "Date (AAAA-MM-JJ) : "

msgid "From (YYYY-MM-DD): "
msgstr "Du (AAAA-MM-JJ) : "

msgid "To (YYYY-MM-DD): "
msgstr "Au (AAAA-MM-JJ) : "

#| msgid "The end must be after the start."
msgid "End date must not be earlier than start date."
msgstr "La date de fin ne peut pas précéder la date de début."

msgid "Press Enter to continue..."
msgstr "Appuyez sur Entrée pour continuer..."

msgid "Dates must use YYYY-MM-DD."
msgstr "Les dates doivent utiliser AAAA-MM-JJ."

msgid "Invalid date; keeping the current date."
msgstr "Date invalide ; la date actuelle est conservée."

#, python-format
msgid "Date: %(date)s"
msgstr "Date : %(date)s"

