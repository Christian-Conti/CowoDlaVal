msgid "Cowo d'la val - information request"
msgstr "Cowo d'la val - demande d'informations"

msgid "Your message has been sent. We will reply as soon as possible."
msgstr "Votre message a été envoyé. Nous vous répondrons dès que possible."

msgid ""
"We could not send your message. Please try again later or contact us by "
"email."
msgstr ""
"Nous n'avons pas pu envoyer votre message. Réessayez plus tard ou contactez-"
"nous par e-mail."

