msgid "For example: extra monitor, projector, wood stove assistance..."
msgstr ""
"Zum Beispiel: zusätzlicher Monitor, Projektor, Hilfe mit dem Holzofen ..."

msgid "You cannot book a past date."
msgstr "Ein vergangenes Datum kann nicht gebucht werden."

msgid "Payment method"
msgstr "Zahlungsart"

msgid "View bookings and payment status by date."
msgstr "Buchungen und Zahlungsstatus nach Datum anzeigen."

msgid "Show YYYY-MM-DD and exit."
msgstr "JJJJ-MM-TT anzeigen und beenden."

msgid "Show today and exit."
msgstr "Heute anzeigen und beenden."

msgid "First date in a non-interactive range."
msgstr "Erstes Datum eines nicht interaktiven Zeitraums."

msgid "Last date in a non-interactive range."
msgstr "Letztes Datum eines nicht interaktiven Zeitraums."

msgid "--from-date and --to-date must be used together."
msgstr "--from-date und --to-date müssen zusammen verwendet werden."

msgid "--to-date cannot be earlier than --from-date."
msgstr "--to-date darf nicht vor --from-date liegen."

msgid "[p]revious [n]ext [j]ump [r]ange [q]uit: "
msgstr "[p] vorher [n] weiter [j] Datum wählen [r] Zeitraum [q] beenden: "

