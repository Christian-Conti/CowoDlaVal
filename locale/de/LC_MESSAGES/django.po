msgstr "Datum (JJJJ-MM-TT): "

msgid "From (YYYY-MM-DD): "
msgstr "Von (JJJJ-MM-TT): "

msgid "To (YYYY-MM-DD): "
msgstr "Bis (JJJJ-MM-TT): "

