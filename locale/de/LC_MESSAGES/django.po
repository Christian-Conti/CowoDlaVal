msgid "End date must not be earlier than start date."
msgstr "Das Enddatum darf nicht vor dem Startdatum liegen."

msgid "Press Enter to continue..."
msgstr "Eingabetaste drücken, um fortzufahren..."

msgid "Dates must use YYYY-MM-DD."
msgstr "Datumsangaben müssen JJJJ-MM-TT verwenden."

msgid "Invalid date; keeping the current date."
msgstr "Ungültiges Datum; das aktuelle Datum bleibt bestehen."

