#, python-format
msgid "Cowo d'la val booking %(code)s"
msgstr "Prenotazione Cowo d'la val %(code)s"

msgid "Desk"
msgstr "Postazione"

msgid "Date"
msgstr "Data"

msgid "Rate"
msgstr "Tariffa"

msgid "Requests or notes"
msgstr "Richieste o note"

msgid "For example: extra monitor, projector, wood stove assistance..."
msgstr ""
"Ad esempio: monitor aggiuntivo, proiettore, assistenza con la stufa a "
"legna..."

msgid "You cannot book a past date."
msgstr "Non puoi prenotare una data passata."

msgid "Payment method"
msgstr "Metodo di pagamento"

msgid "View bookings and payment status by date."
msgstr "Visualizza prenotazioni e stato dei pagamenti per data."

msgid "Show YYYY-MM-DD and exit."
msgstr "Mostra AAAA-MM-GG ed esce."

msgid "Show today and exit."
msgstr "Mostra oggi ed esce."

msgid "First date in a non-interactive range."
msgstr "Prima data di un intervallo non interattivo."

msgid "Last date in a non-interactive range."
msgstr "Ultima data di un intervallo non interattivo."

msgid "--from-date and --to-date must be used together."
msgstr "--from-date e --to-date devono essere usati insieme."

msgid "--to-date cannot be earlier than --from-date."
msgstr "--to-date non può precedere --from-date."

msgid "[p]revious [n]ext [j]ump [r]ange [q]uit: "
msgstr "[p] precedente [n] successivo [j] vai alla data [r] intervallo [q] esci: "

msgid "Date (YYYY-MM-DD): "
msgstr "Data (AAAA-MM-GG): "

msgid "From (YYYY-MM-DD): "
msgstr "Da (AAAA-MM-GG): "

msgid "To (YYYY-MM-DD): "
msgstr "A (AAAA-MM-GG): "

#| msgid "The end must be after the start."
msgid "End date must not be earlier than start date."
msgstr "La data finale non può precedere quella iniziale."

msgid "Press Enter to continue..."
msgstr "Premi Invio per continuare..."

msgid "Dates must use YYYY-MM-DD."
msgstr "Le date devono usare AAAA-MM-GG."

msgid "Invalid date; keeping the current date."
msgstr "Data non valida; mantengo la data corrente."

#, python-format
msgid "Date: %(date)s"
msgstr "Data: %(date)s"

