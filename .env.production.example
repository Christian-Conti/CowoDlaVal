PUBLIC_DOMAIN=cowo.example.org
ENV_FILE=.env.production

DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=cowo.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://cowo.example.org
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_BEHIND_PROXY=True
DJANGO_RATE_LIMITS_ENABLED=True
DJANGO_SESSION_COOKIE_AGE=43200
DJANGO_PASSWORD_RESET_TIMEOUT=3600
PUBLIC_BASE_URL=https://cowo.example.org

DATABASE_URL=postgresql://coworking:REPLACE_WITH_DB_PASSWORD@db:5432/coworking
POSTGRES_DB=coworking
POSTGRES_USER=coworking
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD
CACHE_URL=redis://redis:6379/1

CONTACT_EMAIL=contact@example.org
DEFAULT_FROM_EMAIL=no-reply@example.org
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

BOOKING_PRICE_STANDARD_HALF_DAY=5.00
BOOKING_PRICE_STANDARD_DAILY=8.00
BOOKING_PRICE_STANDARD_WEEKLY=35.00
BOOKING_PRICE_STANDARD_MONTHLY=100.00
BOOKING_PRICE_DISCOUNTED_HALF_DAY=3.00
BOOKING_PRICE_DISCOUNTED_DAILY=5.00
BOOKING_PRICE_DISCOUNTED_WEEKLY=20.00
BOOKING_PRICE_DISCOUNTED_MONTHLY=50.00

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox

SATISPAY_KEY_ID=
SATISPAY_PRIVATE_KEY_PATH=/run/secrets/satispay-private.pem
SATISPAY_ENVIRONMENT=sandbox

PAYMENT_HTTP_TIMEOUT=15
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
